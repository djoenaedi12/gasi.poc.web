{
  "name": "@gasi/monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "core-api",
    "core-starter",
    "core-ui",
    "platform-app"
  ],
  "scripts": {
    "dev": "npm run dev -w platform-app",
    "build": "npm run build:core && npm run build:plugins && npm run build:app",
    "build:core": "echo 'core packages are source-only, no build needed'",
    "build:plugins": "npm run build --workspaces --if-present 2>/dev/null | grep -v 'platform-app\\|core-' || true",
    "build:app": "npm run build -w platform-app",
    "lint": "npm run lint --workspaces --if-present"
  }
}
