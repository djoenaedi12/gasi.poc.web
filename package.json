{
  "name": "@gasi/monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "core-api",
    "core-starter",
    "platform-app",
    "plugins/*"
  ],
  "scripts": {
    "dev":            "npm run dev -w platform-app",
    "build":          "npm run build:core && npm run build:plugins && npm run build:app",
    "build:core":     "echo 'core-api and core-starter are source-only, no build needed'",
    "build:plugins":  "npm run build --workspaces --if-present --ignore-scripts=false 2>/dev/null | grep -v 'platform-app\\|core-api\\|core-starter' || true",
    "build:app":      "npm run build -w platform-app",
    "lint":           "npm run lint --workspaces --if-present"
  }
}
